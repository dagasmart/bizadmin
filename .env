#设置主数据库，mysql|mariadb|pgsql|sqlite|sqlsrv
DB_CONNECTION=pgsql
#写
DB_HOST=127.0.0.1
#读
DB_READ_HOST=127.0.0.1,127.0.0.1
#读写分离除IP外，其他需一致
DB_PORT=5432
DB_DATABASE=laravel_bizadmin
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_ENGINE=InnoDB
#pgsql模式启用
DB_SCHEMA=public
#pgsql数据库字符集编码utf8
DB_CHARSET=utf8
#连接池最大连接数
DB_POOL=20
#排序规则编码 mysql
#DB_CHARSET=utf8mb4
#DB_COLLATION=utf8mb4_unicode_ci


